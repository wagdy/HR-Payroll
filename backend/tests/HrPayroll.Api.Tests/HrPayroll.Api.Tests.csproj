<Project Sdk="Microsoft.NET.Sdk">

  <!-- The API over HTTP, hosted in process (WebApplicationFactory) with everything real behind
       it: PostgreSQL (HRPAYROLL_TEST_DB, skipped when unset) and a fake attendance device. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HrPayroll.Api\HrPayroll.Api.csproj" />
  </ItemGroup>

  <!-- The fake attendance device the Infrastructure tests run against, shared as source. -->
  <ItemGroup>
    <Compile Include="..\HrPayroll.Infrastructure.Tests\FakeZkDevice.cs" Link="Fakes\FakeZkDevice.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
