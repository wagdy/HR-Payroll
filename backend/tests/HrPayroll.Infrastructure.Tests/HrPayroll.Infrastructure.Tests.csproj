<Project Sdk="Microsoft.NET.Sdk">

  <!-- The database (a real PostgreSQL: HRPAYROLL_TEST_DB, skipped when unset), the clock and the attendance devices' protocol against a fake device. Runs on Microsoft.Testing.Platform (the repository's global.json opts dotnet
       test in); the project is an executable too, so `dotnet run` runs the tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HrPayroll.Infrastructure\HrPayroll.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
